---
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<span class="award">
  <!-- Trophy -->
  <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
    <path fill="currentColor" d="M4.5 1.5h7v4.2a3.5 3.5 0 0 1-7 0z"></path>
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      d="M4.5 3H2.2v1.2A2.5 2.5 0 0 0 4.7 6.7M11.5 3h2.3v1.2a2.5 2.5 0 0 1-2.5 2.5"></path>
    <rect x="7.2" y="9" width="1.6" height="2.6" fill="currentColor"></rect>
    <rect x="4.8" y="11.8" width="6.4" height="2.2" rx="0.6" fill="currentColor"></rect>
  </svg>
  {t(lang, 'project.award')}
</span>
