---
/**
 * Contact form. Messages are sent through Web3Forms to the inbox tied to
 * site.contact.formAccessKey — the address itself never appears on the site.
 */
import { site } from '../data/site';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const subjects = ['podcast', 'video', 'teaching', 'other'] as const;
---

<form class="form" data-contact-form novalidate>
  <input type="hidden" name="access_key" value={site.contact.formAccessKey} />
  <input type="hidden" name="from_name" value={`${site.name.en} — website`} />
  <input type="hidden" name="language" value={lang} />
  <!-- Spam trap: real visitors never see or fill this. -->
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="row">
    <label>
      <span>{t(lang, 'form.name')}</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>
      <span>{t(lang, 'form.email')}</span>
      <input name="email" type="email" autocomplete="email" dir="ltr" required />
    </label>
  </div>

  <fieldset>
    <legend>{t(lang, 'form.subject')}</legend>
    <div class="chips">
      {
        subjects.map((s, i) => (
          <label class="chip">
            <input type="radio" name="topic" value={t('en', `form.subject.${s}`)} checked={i === 0} />
            <span>{t(lang, `form.subject.${s}`)}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <label>
    <span>{t(lang, 'form.message')}</span>
    <textarea name="message" rows="5" required></textarea>
  </label>

  <div class="actions">
    <button class="btn btn--solid" type="submit" data-label={t(lang, 'form.send')} data-sending={t(lang, 'form.sending')}>
      {t(lang, 'form.send')}
    </button>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </div>
  <p hidden data-success-text>{t(lang, 'form.success')}</p>
  <p hidden data-error-text>{t(lang, 'form.error')}</p>
</form>

<style>
  .form {
    display: grid;
    gap: 22px;
    max-width: 760px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  label,
  fieldset {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  label > span,
  legend {
    font-size: 13px;
    color: var(--muted);
    padding: 0;
  }
  legend {
    margin-bottom: 8px;
  }
  input:not([type='radio']):not([type='checkbox']),
  textarea {
    width: 100%;
    font: inherit;
    color: var(--fg);
    background: rgb(255 255 255 / 0.55);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.2s, background 0.2s;
  }
  [dir='rtl'] input[dir='ltr'] {
    text-align: right;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--fg);
    background: #fff;
  }
  textarea {
    resize: vertical;
    min-height: 130px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    position: relative;
    display: block;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .chip span {
    display: block;
    padding: 8px 15px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    color: var(--fg-soft);
    transition: all 0.2s var(--ease);
  }
  .chip input:checked + span {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .btn[disabled] {
    opacity: 0.6;
    pointer-events: none;
  }
  .status {
    margin: 0;
    font-size: 15px;
  }
  .status.is-error {
    color: var(--accent);
  }
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    opacity: 0;
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const successText = form.querySelector<HTMLElement>('[data-success-text]')!.textContent!;
    const errorText = form.querySelector<HTMLElement>('[data-error-text]')!.textContent!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      data.set('subject', `Website: ${data.get('topic')} — ${data.get('name')}`);
      data.set('replyto', String(data.get('email')));

      button.disabled = true;
      button.textContent = button.dataset.sending!;
      status.textContent = '';
      status.classList.remove('is-error');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || res.statusText);
        form.reset();
        status.textContent = successText;
      } catch {
        status.textContent = errorText;
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.label!;
      }
    });
  });
</script>
