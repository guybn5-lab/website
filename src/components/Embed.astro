---
/**
 * Embeds a piece of content from its normal share link — no embed codes needed.
 * Supports YouTube, Vimeo, Instagram posts/reels, TikTok videos, Spotify episodes/shows
 * (including video episodes), Apple Podcasts episodes/shows and Facebook videos.
 * Unknown links render as a plain link.
 */
import { embedKind } from '../lib/embeds';

interface Props {
  url: string;
  title?: string;
}
const { url, title = '' } = Astro.props;
const { src, kind } = embedKind(url);
---

{
  kind === 'link' ? (
    <a class="embed-link btn" href={url} target="_blank" rel="noopener">
      {title || url} <span aria-hidden="true">↗</span>
    </a>
  ) : kind === 'instagram' ? (
    <div class="embed embed--instagram">
      {/* Instagram's embed.js (loaded once by the page) turns this into a correctly sized post. */}
      <blockquote class="instagram-media" data-instgrm-permalink={src} data-instgrm-version="14">
        <a href={src} target="_blank" rel="noopener">
          {title || 'Instagram'} ↗
        </a>
      </blockquote>
    </div>
  ) : (
    <div class:list={['embed', `embed--${kind}`]}>
      <iframe
        src={src}
        title={title || url}
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        allowfullscreen
      />
    </div>
  )
}

<style>
  .embed {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }
  .embed iframe {
    display: block;
    width: 100%;
    border: 0;
  }
  .embed--video iframe {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  .embed--spotify-video iframe {
    height: 351px;
  }
  .embed--tiktok {
    max-width: 340px;
    margin-inline: auto;
    background: #fff;
  }
  .embed--tiktok iframe {
    height: 740px;
  }
  .embed--instagram {
    overflow: visible;
    border-radius: 0;
  }
  .embed--instagram :global(.instagram-media) {
    margin: 0 auto !important;
    min-width: 0 !important;
    width: 100% !important;
    max-width: 420px !important;
    border-radius: 12px !important;
  }
  .embed--audio iframe {
    height: 152px;
  }
  .embed--audio-list iframe {
    height: 450px;
  }
</style>
