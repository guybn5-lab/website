---
/** A single podcast episode with its own audio player — no third-party embed needed. */
import type { Lang } from '../i18n/ui';

interface Props {
  episode: {
    title: string;
    date?: string;
    description?: string;
    url?: string;
    audio?: string;
    duration?: string;
    image?: string;
  };
  lang: Lang;
  source?: string;
}
const { episode: e, lang, source } = Astro.props;
const date = e.date
  ? new Intl.DateTimeFormat(lang === 'he' ? 'he-IL' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(
      new Date(e.date),
    )
  : '';
const duration = e.duration && lang === 'he' ? e.duration.replace('min', 'דק׳') : e.duration;
---

<article class="episode">
  {e.image && <img class="thumb" src={e.image} alt="" loading="lazy" decoding="async" />}
  <div class="body">
    <p class="meta">
      {date && <time datetime={e.date}>{date}</time>}
      {duration && <span>{duration}</span>}
    </p>
    <h3 lang="en" dir="ltr">
      {
        e.url ? (
          <a href={e.url} target="_blank" rel="noopener">
            {e.title}
          </a>
        ) : (
          e.title
        )
      }
    </h3>
    {e.description && <p class="desc" lang="en" dir="ltr">{e.description}</p>}
    {e.audio && <audio controls preload="none" src={e.audio} aria-label={e.title} />}
    {
      e.url && source && (
        <a class="source" href={e.url} target="_blank" rel="noopener">
          {source} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .episode {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    padding: 18px;
    background: rgb(255 255 255 / 0.5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .thumb {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: 8px;
    background: var(--bg-raised);
  }
  .meta {
    display: flex;
    gap: 10px;
    margin: 0 0 6px;
    font-size: 12px;
    color: var(--muted);
  }
  .meta span::before {
    content: '·';
    margin-inline-end: 10px;
  }
  h3 {
    font-size: 20px;
    line-height: 1.25;
    text-align: start;
  }
  :global([dir='rtl']) h3,
  :global([dir='rtl']) .desc {
    text-align: right;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .desc {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  audio {
    width: 100%;
    height: 36px;
    margin-top: 12px;
    accent-color: var(--accent);
  }
  .source {
    display: inline-block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .source:hover {
    color: var(--fg);
  }
  @media (max-width: 520px) {
    .episode {
      grid-template-columns: 1fr;
    }
    .thumb {
      aspect-ratio: 16 / 9;
    }
  }
</style>
