---
import { site } from '../data/site';
import { localHref, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const other = otherLang(lang);
const socials = site.social.filter((s) => s.url);
---

<footer class="site-footer" id="contact">
  <div class="wrap">
    <div class="cta reveal">
      <p class="eyebrow">{t(lang, 'nav.contact')}</p>
      <h2>{t(lang, 'contact.title')}</h2>
      <p class="muted">{t(lang, 'contact.text')}</p>
      {site.contact.email && <a class="mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}
      {
        !site.contact.email && socials.length > 0 && (
          <p class="cta-links">
            {socials.map((s) => (
              <a class="btn" href={s.url} rel="noopener me" target="_blank">
                {s.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </p>
        )
      }
    </div>

    <div class="cols">
      <dl>
        {
          site.contact.phone && (
            <div>
              <dt class="eyebrow">{t(lang, 'contact.phone')}</dt>
              <dd>
                <a class="link-underline" href={`tel:${site.contact.phone.replace(/[^+\d]/g, '')}`} dir="ltr">
                  {site.contact.phone}
                </a>
              </dd>
            </div>
          )
        }
        {
          site.contact.whatsapp && (
            <div>
              <dt class="eyebrow">{t(lang, 'contact.whatsapp')}</dt>
              <dd>
                <a class="link-underline" href={`https://wa.me/${site.contact.whatsapp}`} rel="noopener" target="_blank">
                  wa.me/{site.contact.whatsapp}
                </a>
              </dd>
            </div>
          )
        }
        {
          site.contact.email && socials.length > 0 && (
            <div>
              <dt class="eyebrow">{t(lang, 'contact.elsewhere')}</dt>
              <dd class="socials">
                {socials.map((s) => (
                  <a class="link-underline" href={s.url} rel="noopener me" target="_blank">
                    {s.label}
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    <div class="legal">
      <span>© {new Date().getFullYear()} {site.name[lang]}. {t(lang, 'footer.rights')}</span>
      {site.contact.location[lang] && <span>{site.contact.location[lang]}</span>}
      <a class="link-underline" href={localHref(other, path)} hreflang={other} lang={other}>{t(lang, 'lang.switch')}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(80px, 12vw, 180px);
    border-top: 1px solid var(--line);
    padding-block: clamp(56px, 8vw, 120px) 32px;
  }
  .cta h2 {
    font-size: clamp(40px, 7vw, 104px);
    margin: 16px 0 20px;
    max-width: 14ch;
  }
  .cta p {
    max-width: 46ch;
  }
  .mail {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: clamp(24px, 3.4vw, 44px);
    border-bottom: 1px solid var(--line);
    padding-bottom: 4px;
    transition: border-color 0.3s;
    word-break: break-all;
  }
  .mail:hover {
    border-color: var(--fg);
  }
  .cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .cols:not(:has(div)) {
    display: none;
  }
  .cols {
    margin-top: clamp(48px, 6vw, 80px);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    margin: 0;
  }
  dd {
    margin: 8px 0 0;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: clamp(56px, 8vw, 100px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
</style>
