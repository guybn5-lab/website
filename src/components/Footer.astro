---
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';
import { localHref, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const other = otherLang(lang);
const socials = site.social.filter((s) => s.url);
const { email, phone, whatsapp } = site.contact;
---

<footer class="site-footer" id="contact">
  <div class="wrap">
    <div class="contact">
      <div class="cta reveal">
        <p class="eyebrow">{t(lang, 'nav.contact')}</p>
        <h2>{t(lang, 'contact.title')}</h2>
        <p class="muted">{t(lang, 'contact.text')}</p>

        <dl class="details">
          {
            email && (
              <div>
                <dt class="eyebrow">{t(lang, 'contact.email')}</dt>
                <dd>
                  <a class="link-underline" href={`mailto:${email}`}>
                    {email}
                  </a>
                </dd>
              </div>
            )
          }
          {
            phone && (
              <div>
                <dt class="eyebrow">{t(lang, 'contact.phone')}</dt>
                <dd>
                  <a class="link-underline" href={`tel:${phone.replace(/[^+\d]/g, '')}`} dir="ltr">
                    {phone}
                  </a>
                </dd>
              </div>
            )
          }
          {
            whatsapp && (
              <div>
                <dt class="eyebrow">{t(lang, 'contact.whatsapp')}</dt>
                <dd>
                  <a class="link-underline" href={`https://wa.me/${whatsapp}`} rel="noopener" target="_blank">
                    wa.me/{whatsapp}
                  </a>
                </dd>
              </div>
            )
          }
          {
            socials.length > 0 && (
              <div>
                <dt class="eyebrow">{t(lang, 'contact.elsewhere')}</dt>
                <dd class="socials">
                  {socials.map((s) => (
                    <a class="link-underline" href={s.url} rel="noopener me" target="_blank">
                      {s.label}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      <div class="form-wrap reveal">
        <ContactForm lang={lang} />
      </div>
    </div>

    <div class="legal">
      <span>© {new Date().getFullYear()} {site.name[lang]}. {t(lang, 'footer.rights')}</span>
      {site.contact.location[lang] && <span>{site.contact.location[lang]}</span>}
      <a class="link-underline" href={localHref(other, path)} hreflang={other} lang={other}>{t(lang, 'lang.switch')}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(80px, 12vw, 180px);
    border-top: 1px solid var(--line);
    padding-block: clamp(56px, 8vw, 120px) 32px;
    scroll-margin-top: var(--header-h);
  }
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 112px);
    align-items: start;
  }
  .cta h2 {
    font-size: clamp(44px, 6vw, 96px);
    margin: 16px 0 20px;
    max-width: 10ch;
  }
  .cta > p {
    max-width: 40ch;
  }
  .details {
    display: grid;
    gap: 22px;
    margin: clamp(32px, 4vw, 48px) 0 0;
  }
  dd {
    margin: 6px 0 0;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .form-wrap {
    padding: clamp(24px, 3vw, 40px);
    background: var(--bg-raised);
    border-radius: var(--radius);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: clamp(56px, 8vw, 100px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
