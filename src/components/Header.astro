---
import { site } from '../data/site';
import { categories, categoryLabels, localHref, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  overlay?: boolean;
  /** Highlights a nav item when the page path alone doesn't (e.g. project pages → '/documentary/'). */
  section?: string;
}

const { lang, path, overlay = false, section } = Astro.props;
const other = otherLang(lang);

const nav = [
  ...categories.map((c) => ({ path: `/${c}/`, label: categoryLabels[c][lang] })),
  { path: '/about/', label: t(lang, 'nav.about') },
];
const current = (p: string) => (section ?? path).startsWith(p);
---

<header class:list={['site-header', { 'is-overlay': overlay }]} data-header>
  <div class="bar wrap">
    <a class="brand" href={localHref(lang)}>
      <span class="rec" aria-hidden="true"></span>
      {site.name[lang]}
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                class="link-underline"
                href={localHref(lang, item.path)}
                aria-current={current(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="lang" href={localHref(other, path)} hreflang={other} lang={other} aria-label={t(lang, 'lang.switchLabel')}>
        {t(lang, 'lang.switch')}
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
      <span class="menu-label" data-open-label={t(lang, 'nav.menu')} data-close-label={t(lang, 'nav.close')}>
        {t(lang, 'nav.menu')}
      </span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <ul class="wrap">
      {
        nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={localHref(lang, item.path)} aria-current={current(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li style={`--i:${nav.length}`} class="mobile-lang">
        <a href={localHref(other, path)} hreflang={other} lang={other}>{t(lang, 'lang.switch')}</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgb(245 242 236 / 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .site-header.is-overlay {
    position: fixed;
    inset-inline: 0;
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header.is-overlay.is-scrolled,
  .site-header.menu-open {
    background: rgb(245 242 236 / 0.94);
    border-color: var(--line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 23px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .rec {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 2.4s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.6vw, 40px);
    font-size: 14px;
  }
  .nav ul {
    display: flex;
    gap: clamp(20px, 2.6vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a[aria-current='page'] {
    color: var(--fg);
  }
  .nav ul a {
    color: var(--fg-soft);
    transition: color 0.2s;
  }
  .nav ul a:hover {
    color: var(--fg);
  }
  .lang {
    padding: 6px 13px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-size: 13px;
    transition: background 0.2s, color 0.2s;
  }
  .lang:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .menu-btn {
    display: none;
    font-size: 14px;
    padding: 10px 0;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--bg);
    overflow-y: auto;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding-block: 32px;
  }
  .mobile-menu li {
    border-bottom: 1px solid var(--line);
    animation: slide-in 0.5s var(--ease) both;
    animation-delay: calc(var(--i) * 50ms);
  }
  .mobile-menu a {
    display: block;
    padding: 18px 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 8vw, 44px);
    line-height: 1.1;
  }
  .mobile-menu .mobile-lang a {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--muted);
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 980px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const label = btn.querySelector<HTMLElement>('.menu-label')!;

  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    header.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    label.textContent = (open ? label.dataset.closeLabel : label.dataset.openLabel) ?? '';
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && !menu.hidden && setOpen(false));
  matchMedia('(min-width: 981px)').addEventListener('change', (e) => e.matches && setOpen(false));

  const onScroll = () => header.classList.toggle('is-scrolled', scrollY > 40);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
