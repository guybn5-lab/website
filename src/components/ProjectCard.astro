---
import Media from './Media.astro';
import Award from './Award.astro';
import { categoryLabels, formatLabels, href, localHref, type Lang } from '../i18n/ui';
import { coverFor, localize, type Project } from '../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
  showCategory?: boolean;
  eager?: boolean;
}
const { project: p, lang, showCategory = false, eager = false } = Astro.props;
const title = localize(p.title, lang);
const meta = [
  showCategory ? categoryLabels[p.category][lang] : '',
  p.format ? localize(formatLabels[p.format], lang) : '',
  localize(p.client, lang),
  p.year ? String(p.year) : '',
].filter(Boolean);
---

<article class="card reveal" data-category={p.category}>
  <a href={localHref(lang, `/work/${p.slug}/`)} class="card-link">
    <Media src={coverFor(p)} alt="" seed={p.slug} eager={eager} ratio="1 / 1" class="card-media">
      {
        p.preview && (
          <video
            class="preview"
            src={href(p.preview)}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-preview
          />
        )
      }
      {p.award && <span class="badge"><Award lang={lang} /></span>}
    </Media>
    <div class="meta">
      <h3>{title}</h3>
      {meta.length > 0 && <p class="sub">{meta.map((m) => <span>{m}</span>)}</p>}
      {
        (p.highlight || p.summary) && (
          <p class="summary">{localize(p.highlight, lang) || localize(p.summary, lang)}</p>
        )
      }
    </div>
  </a>
</article>

<style>
  .card-link {
    display: block;
  }
  .card :global(.card-media) {
    border-radius: var(--radius);
    box-shadow: 0 1px 0 var(--line);
  }
  .card :global(.card-media img),
  .card :global(.card-media .ph) {
    transition: transform 1s var(--ease);
  }
  .card-link:hover :global(.card-media img),
  .card-link:hover :global(.card-media .ph) {
    transform: scale(1.04);
  }
  .badge {
    position: absolute;
    top: 12px;
    inset-inline-start: 12px;
  }
  .preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .card-link:hover .preview.is-playing {
    opacity: 1;
  }
  .meta {
    padding-top: 16px;
  }
  h3 {
    font-size: clamp(24px, 2vw, 30px);
    transition: color 0.2s;
  }
  .card-link:hover h3 {
    color: var(--accent);
  }
  .sub {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .sub span:not(:last-child)::after {
    content: '·';
    margin-inline: 8px;
    opacity: 0.7;
  }
  .summary {
    margin: 8px 0 0;
    max-width: 48ch;
    color: var(--fg-soft);
    font-size: 15px;
    line-height: 1.5;
  }
</style>

<script>
  // Play the short silent preview while hovering (pointer devices only).
  if (matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-preview]').forEach((video) => {
      const link = video.closest('a')!;
      link.addEventListener('mouseenter', () => {
        video.play().then(() => video.classList.add('is-playing')).catch(() => {});
      });
      link.addEventListener('mouseleave', () => {
        video.pause();
        video.classList.remove('is-playing');
      });
    });
  }
</script>
