---
/**
 * Click-to-play video. Shows the cover with a play button and only loads
 * the YouTube/Vimeo player when clicked — keeps pages fast and cookie-free.
 */
import Media from './Media.astro';
import { t, type Lang } from '../i18n/ui';
import { embedUrl } from '../lib/projects';
import type { VideoRef } from '../data/site';

interface Props {
  video?: VideoRef;
  cover?: string;
  title: string;
  seed: string;
  lang: Lang;
}
const { video, cover, title, seed, lang } = Astro.props;
const src = embedUrl(video);
---

<div class="player" data-player data-src={src} data-title={title}>
  <Media src={cover} alt={title} seed={seed} eager>
    {
      src ? (
        <button type="button" class="play" data-play aria-label={`${t(lang, 'project.play')}: ${title}`}>
          <span class="disc">
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
            </svg>
          </span>
        </button>
      ) : (
        <span class="soon eyebrow">{t(lang, 'project.noVideo')}</span>
      )
    }
  </Media>
</div>

<style>
  .player {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(to top, rgb(0 0 0 / 0.3), transparent 60%);
    color: #fff;
  }
  .disc {
    display: grid;
    place-items: center;
    width: clamp(64px, 8vw, 96px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
    border: 1px solid rgb(255 255 255 / 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: transform 0.4s var(--ease), background 0.3s;
  }
  .disc svg {
    margin-inline-start: 4px;
  }
  :global([dir='rtl']) .disc svg {
    margin-inline-start: 0;
    margin-inline-end: 4px;
  }
  .play:hover .disc {
    transform: scale(1.08);
    background: var(--accent);
    border-color: var(--accent);
  }
  .soon {
    position: absolute;
    inset-inline-start: 20px;
    bottom: 18px;
  }
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const btn = player.querySelector<HTMLButtonElement>('[data-play]');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = player.dataset.src!;
      iframe.title = player.dataset.title!;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
