---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { site } from '../../../data/site';
import {
  categories,
  categoryIntros,
  categoryLabels,
  languages,
  t,
  type Category,
  type Lang,
} from '../../../i18n/ui';
import { byCategory, paragraphs } from '../../../lib/projects';

export const getStaticPaths = () =>
  languages.flatMap((lang) => categories.map((category) => ({ params: { lang, category } })));

const lang = Astro.params.lang as Lang;
const category = Astro.params.category as Category;
const list = byCategory(category);
const label = categoryLabels[category][lang];
const isTeaching = category === 'knowledge-sharing';
---

<Base lang={lang} path={`/${category}/`} title={label} description={categoryIntros[category][lang]}>
  <header class="page-head wrap">
    <p class="eyebrow">
      {String(categories.indexOf(category) + 1).padStart(2, '0')} / {String(categories.length).padStart(2, '0')}
    </p>
    <div class="head-row">
      <h1>{label}</h1>
      {
        isTeaching && (
          <button type="button" class="stamp" data-names-open aria-haspopup="dialog" aria-label={t(lang, 'names.badgeLabel')}>
            <span aria-hidden="true">{t(lang, 'names.badge')}</span>
          </button>
        )
      }
    </div>
    <p class="intro">{categoryIntros[category][lang]}</p>
  </header>

  {
    isTeaching && site.courses.length > 0 && (
      <section class="courses wrap">
        <h2 class="eyebrow">{t(lang, 'teaching.courses')}</h2>
        <ul>
          {site.courses.map((c) => (
            <li class="reveal">
              <span class="years" dir="ltr">
                {c.years}
              </span>
              <span class="title">{c.title[lang]}</span>
              <span class="where">{c.where[lang]}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    isTeaching && site.courses.length === 0 && list.length === 0 && (
      <section class="wrap empty">
        <p>{t(lang, 'teaching.empty')}</p>
        <a class="btn btn--solid" href="#contact">{t(lang, 'nav.contact')}</a>
      </section>
    )
  }

  {
    list.length > 0 && (
      <section class="wrap list">
        {isTeaching && <h2 class="eyebrow list-head">{t(lang, 'teaching.work')}</h2>}
        <div class="grid">
          {list.map((p, i) => (
            <ProjectCard project={p} lang={lang} showCategory={false} eager={i < 2} />
          ))}
        </div>
      </section>
    )
  }

  {
    isTeaching && (
      <dialog class="names" data-names aria-labelledby="names-title">
        <button type="button" class="names-close" data-names-close>
          {t(lang, 'nav.close')} ✕
        </button>
        <p class="eyebrow">{t(lang, 'names.eyebrow')}</p>
        <h2 id="names-title">{t(lang, 'names.title')}</h2>
        <div class="names-pair" aria-hidden="true">
          <span lang="en" dir="ltr">Szafman <small>Paris · London</small></span>
          <span lang="he" dir="rtl">בן נון <small>ישראל</small></span>
        </div>
        {paragraphs(t(lang, 'names.body')).map((para) => <p>{para}</p>)}
      </dialog>
    )
  }
</Base>

<style>
  .page-head {
    padding-top: clamp(56px, 9vw, 140px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  h1 {
    font-size: clamp(52px, 10vw, 160px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: 20px;
    max-width: 12ch;
  }
  :root[lang='he'] h1 {
    letter-spacing: -0.01em;
  }
  .intro {
    max-width: 52ch;
    margin-top: clamp(20px, 3vw, 36px);
    font-size: clamp(18px, 1.5vw, 21px);
    color: var(--fg-soft);
  }
  .list-head,
  .courses h2 {
    padding-bottom: 18px;
    margin-bottom: clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
  }
  .empty {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .empty p {
    max-width: 48ch;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.35;
  }
  .courses {
    margin-bottom: clamp(72px, 9vw, 140px);
  }
  .courses h2 {
    margin-bottom: 0;
  }
  .courses ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .courses li {
    display: grid;
    grid-template-columns: 160px minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 8px 24px;
    align-items: baseline;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }
  .years {
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: start;
  }
  :global([dir='rtl']) .years {
    text-align: end;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.2;
  }
  .where {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .courses li {
      grid-template-columns: 1fr;
    }
  }
  /* Hidden "why two names?" stamp (knowledge-sharing page only) */
  .head-row {
    display: flex;
    align-items: flex-start;
    gap: clamp(12px, 2vw, 28px);
  }
  .stamp {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-top: clamp(24px, 3vw, 40px);
    border: 1.5px dashed var(--accent);
    border-radius: 50%;
    outline: 1.5px solid var(--accent);
    outline-offset: 3px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.55;
    transform: rotate(-14deg);
    cursor: pointer;
    transition:
      opacity 0.3s var(--ease),
      transform 0.4s var(--ease);
  }
  .stamp:hover,
  .stamp:focus-visible {
    opacity: 1;
    transform: rotate(0deg) scale(1.08);
  }
  .stamp:focus-visible {
    outline-color: var(--fg);
  }
  :root[lang='he'] .stamp {
    font-size: 11px;
    letter-spacing: 0;
  }
  .names {
    width: min(92vw, 560px);
    padding: clamp(24px, 4vw, 44px);
    border: 0;
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--fg);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.25);
  }
  .names::backdrop {
    background: rgb(10 10 10 / 0.6);
  }
  .names h2 {
    margin: 12px 0 20px;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
  }
  .names p:not(.eyebrow) {
    margin: 0 0 14px;
    color: var(--fg-soft);
  }
  .names-pair {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    padding-block: 14px;
    border-block: 1px dashed var(--line);
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
  }
  .names-pair span {
    display: grid;
  }
  .names-pair small {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .names-close {
    display: block;
    margin: 0 0 8px auto;
    font-size: 14px;
    color: var(--muted);
  }
  :global([dir='rtl']) .names-close {
    margin: 0 auto 8px 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp {
      transition: none;
    }
  }
</style>

<script>
  // Hidden "why two names?" fun fact
  const names = document.querySelector<HTMLDialogElement>('[data-names]');
  const opener = document.querySelector<HTMLButtonElement>('[data-names-open]');
  if (names && opener) {
    opener.addEventListener('click', () => names.showModal());
    names.querySelector('[data-names-close]')!.addEventListener('click', () => names.close());
    // Close on backdrop clicks only (the dialog has padding, so check the click is outside its box).
    names.addEventListener('click', (e) => {
      const r = names.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) names.close();
    });
  }
</script>
