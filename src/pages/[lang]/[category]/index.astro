---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { site } from '../../../data/site';
import {
  categories,
  categoryIntros,
  categoryLabels,
  languages,
  t,
  type Category,
  type Lang,
} from '../../../i18n/ui';
import { byCategory } from '../../../lib/projects';

export const getStaticPaths = () =>
  languages.flatMap((lang) => categories.map((category) => ({ params: { lang, category } })));

const lang = Astro.params.lang as Lang;
const category = Astro.params.category as Category;
const list = byCategory(category);
const label = categoryLabels[category][lang];
const isTeaching = category === 'teaching';
---

<Base lang={lang} path={`/${category}/`} title={label} description={categoryIntros[category][lang]}>
  <header class="page-head wrap">
    <p class="eyebrow">
      {String(categories.indexOf(category) + 1).padStart(2, '0')} / {String(categories.length).padStart(2, '0')}
    </p>
    <h1>{label}</h1>
    <p class="intro">{categoryIntros[category][lang]}</p>
  </header>

  {
    isTeaching && site.courses.length > 0 && (
      <section class="courses wrap">
        <h2 class="eyebrow">{t(lang, 'teaching.courses')}</h2>
        <ul>
          {site.courses.map((c) => (
            <li class="reveal">
              <span class="years" dir="ltr">
                {c.years}
              </span>
              <span class="title">{c.title[lang]}</span>
              <span class="where">{c.where[lang]}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    isTeaching && site.courses.length === 0 && list.length === 0 && (
      <section class="wrap empty">
        <p>{t(lang, 'teaching.empty')}</p>
        <a class="btn btn--solid" href="#contact">{t(lang, 'nav.contact')}</a>
      </section>
    )
  }

  {
    list.length > 0 && (
      <section class="wrap list">
        {isTeaching && <h2 class="eyebrow list-head">{t(lang, 'teaching.work')}</h2>}
        <div class="grid">
          {list.map((p, i) => (
            <ProjectCard project={p} lang={lang} showCategory={false} eager={i < 2} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .page-head {
    padding-top: clamp(56px, 9vw, 140px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  h1 {
    font-size: clamp(52px, 10vw, 160px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: 20px;
    max-width: 12ch;
  }
  :root[lang='he'] h1 {
    letter-spacing: -0.01em;
  }
  .intro {
    max-width: 52ch;
    margin-top: clamp(20px, 3vw, 36px);
    font-size: clamp(18px, 1.5vw, 21px);
    color: var(--fg-soft);
  }
  .list-head,
  .courses h2 {
    padding-bottom: 18px;
    margin-bottom: clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
  }
  .empty {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .empty p {
    max-width: 48ch;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.35;
  }
  .courses {
    margin-bottom: clamp(72px, 9vw, 140px);
  }
  .courses h2 {
    margin-bottom: 0;
  }
  .courses ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .courses li {
    display: grid;
    grid-template-columns: 160px minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 8px 24px;
    align-items: baseline;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }
  .years {
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: start;
  }
  :global([dir='rtl']) .years {
    text-align: end;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.2;
  }
  .where {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .courses li {
      grid-template-columns: 1fr;
    }
  }
</style>
