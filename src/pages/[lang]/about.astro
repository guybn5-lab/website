---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { site } from '../../data/site';
import { langPaths, t, type Lang } from '../../i18n/ui';
import { paragraphs } from '../../lib/projects';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const bio = paragraphs(site.bio[lang]);
---

<Base lang={lang} path="/about/" title={t(lang, 'about.title')} description={site.intro[lang]} image={site.portrait || undefined}>
  <section class="about wrap">
    <div class="side">
      <Media src={site.portrait} alt={site.name[lang]} seed="portrait" ratio="4 / 5" eager />
    </div>
    <div class="main">
      <p class="eyebrow">{t(lang, 'about.title')}</p>
      <h1>{site.name[lang]}</h1>
      <div class="bio">
        {bio.map((para, i) => <p class:list={{ first: i === 0 }}>{para}</p>)}
      </div>

      {
        site.clients[lang].length > 0 && (
          <section class="clients">
            <h2 class="eyebrow">{t(lang, 'about.clients')}</h2>
            <ul>
              {site.clients[lang].map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 112px);
    padding-top: clamp(48px, 7vw, 110px);
  }
  .side {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }
  h1 {
    margin: 20px 0 clamp(28px, 4vw, 48px);
    font-size: clamp(48px, 7vw, 110px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  :root[lang='he'] h1 {
    letter-spacing: -0.01em;
  }
  .bio {
    max-width: 60ch;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.7;
  }
  .bio .first {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.35;
    margin-bottom: 1.2em;
  }
  .clients {
    margin-top: clamp(48px, 6vw, 80px);
  }
  .clients ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    border-top: 1px solid var(--line);
  }
  .clients li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      max-width: 420px;
    }
  }
</style>
