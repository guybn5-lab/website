---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';
import {
  categories,
  categoryIntros,
  categoryLabels,
  formatLabels,
  href,
  langPaths,
  localHref,
  t,
  type Lang,
} from '../../i18n/ui';
import { byCategory, embedUrl, featured, localize, projects } from '../../lib/projects';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;

const work = featured();
const usedCategories = categories.filter((c) => work.some((p) => p.category === c));
const reelSrc = embedUrl(site.showreel.full);
---

<Base lang={lang} path="/">
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow roles">
        {site.roles[lang].map((r) => <span>{r}</span>)}
      </p>
      <h1>{site.name[lang]}</h1>
      <p class="intro">{site.intro[lang]}</p>
      <div class="actions">
        <a class="btn btn--solid" href="#work">{t(lang, 'home.selected')}</a>
        {
          reelSrc && (
            <button type="button" class="btn" data-reel-open>
              <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
              </svg>
              {t(lang, 'home.reel')}
            </button>
          )
        }
        <a class="btn" href="#contact">{t(lang, 'nav.contact')}</a>
      </div>
    </div>
    <div class="hero-media">
      {
        site.showreel.loop ? (
          <div class="loop">
            <video
              src={href(site.showreel.loop)}
              poster={site.showreel.poster ? href(site.showreel.poster) : undefined}
              autoplay
              muted
              loop
              playsinline
              aria-hidden="true"
            />
          </div>
        ) : (
          <Media src={site.portrait} alt={site.name[lang]} seed="portrait" ratio="4 / 5" eager class="portrait" />
        )
      }
    </div>
  </section>

  <section class="work wrap" id="work">
    <div class="section-head">
      <h2 class="eyebrow">{t(lang, 'home.selected')}</h2>
      {
        usedCategories.length > 1 && (
          <div class="filters" role="group" aria-label={t(lang, 'home.selected')}>
            <button type="button" aria-pressed="true" data-filter="all">
              {t(lang, 'home.all')}
              <sup>{work.length}</sup>
            </button>
            {usedCategories.map((c) => (
              <button type="button" aria-pressed="false" data-filter={c}>
                {categoryLabels[c][lang]}
                <sup>{work.filter((p) => p.category === c).length}</sup>
              </button>
            ))}
          </div>
        )
      }
    </div>
    <div class="grid" data-grid>
      {work.map((p, i) => <ProjectCard project={p} lang={lang} showCategory eager={i < 3} />)}
    </div>
  </section>

  <section class="index wrap" aria-labelledby="index-title">
    <div class="section-head">
      <h2 class="eyebrow" id="index-title">{t(lang, 'home.indexAll')}</h2>
      <span class="eyebrow">{projects.length}</span>
    </div>
    <ul>
      {
        projects.map((p) => (
          <li>
            <a href={localHref(lang, `/work/${p.slug}/`)}>
              <span class="i-title">
                {localize(p.title, lang)}
                {p.award && (
                  <span class="star" title={t(lang, 'project.award')}>
                    ★<span class="sr-only">{t(lang, 'project.award')}</span>
                  </span>
                )}
              </span>
              <span class="i-client">{localize(p.client, lang)}</span>
              <span class="i-format">{p.format ? localize(formatLabels[p.format], lang) : ''}</span>
              <span class="i-cat">{categoryLabels[p.category][lang]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="practices wrap">
    <div class="section-head">
      <h2 class="eyebrow">{t(lang, 'home.practices')}</h2>
    </div>
    <ol>
      {
        categories.map((c, i) => {
          const n = byCategory(c).length;
          return (
            <li class="reveal">
              <a href={localHref(lang, `/${c}/`)}>
                <span class="num">0{i + 1}</span>
                <span class="name">{categoryLabels[c][lang]}</span>
                <span class="desc">{categoryIntros[c][lang]}</span>
                <span class="count">
                  {n > 0 ? n : ''}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  {
    reelSrc && (
      <dialog class="reel" data-reel data-src={reelSrc} aria-label={t(lang, 'home.reel')}>
        <button type="button" class="reel-close" data-reel-close>
          {t(lang, 'nav.close')} ✕
        </button>
        <div class="reel-frame" data-reel-frame />
      </dialog>
    )
  }
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
    padding-top: clamp(48px, 7vw, 110px);
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin-bottom: 22px;
  }
  .roles span:not(:last-child)::after {
    content: '·';
    margin-inline: 10px;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(64px, 11vw, 176px);
    line-height: 0.9;
    letter-spacing: -0.035em;
    animation: rise 1.1s var(--ease) both;
  }
  :root[lang='he'] h1 {
    letter-spacing: -0.01em;
    line-height: 0.95;
  }
  .intro {
    max-width: 34ch;
    margin: clamp(24px, 3vw, 36px) 0 0;
    font-family: var(--font-display);
    font-size: clamp(21px, 2vw, 28px);
    line-height: 1.35;
    animation: rise 1.1s 0.12s var(--ease) both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(28px, 3vw, 40px);
    animation: rise 1.1s 0.24s var(--ease) both;
  }
  .hero-media {
    animation: fade 1.4s 0.1s var(--ease) both;
  }
  .hero-media :global(.portrait),
  .loop {
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero-media :global(.portrait img) {
    object-position: 50% 40%;
  }
  .loop {
    aspect-ratio: 4 / 5;
  }
  .loop video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-media {
      order: -1;
      max-width: 420px;
    }
    .hero-media :global(.portrait) {
      aspect-ratio: 3 / 2 !important;
    }
  }

  /* Selected work */
  .work {
    padding-top: clamp(80px, 10vw, 150px);
    scroll-margin-top: var(--header-h);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filters button {
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    color: var(--fg-soft);
    transition: all 0.2s var(--ease);
  }
  .filters sup {
    font-size: 9px;
    margin-inline-start: 2px;
  }
  .filters button:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .filters button[aria-pressed='true'] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .grid :global(.card[hidden]) {
    display: none;
  }

  /* Index */
  .index {
    padding-top: clamp(96px, 11vw, 160px);
  }
  .index ul {
    list-style: none;
    margin: -1px 0 0;
    padding: 0;
  }
  .index li {
    border-bottom: 1px solid var(--line);
  }
  .index a {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 4px 24px;
    align-items: baseline;
    padding-block: 16px;
    transition: color 0.2s, padding 0.4s var(--ease);
  }
  .index a:hover {
    color: var(--accent);
    padding-inline-start: 10px;
  }
  .i-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.2;
  }
  .star {
    color: var(--accent);
    font-size: 0.6em;
    vertical-align: super;
    margin-inline-start: 6px;
  }
  .i-client,
  .i-format,
  .i-cat {
    font-size: 14px;
    color: var(--muted);
  }
  .i-cat {
    text-align: end;
  }
  @media (max-width: 760px) {
    .index a {
      grid-template-columns: 1fr auto;
    }
    .i-format,
    .i-cat {
      display: none;
    }
  }

  /* Practices index */
  .practices {
    padding-top: clamp(96px, 11vw, 160px);
  }
  .practices ol {
    list-style: none;
    margin: -1px 0 0;
    padding: 0;
  }
  .practices li {
    border-bottom: 1px solid var(--line);
  }
  .practices a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 1fr) 72px;
    gap: 24px;
    align-items: baseline;
    padding-block: clamp(24px, 3.2vw, 44px);
    transition: padding 0.5s var(--ease);
  }
  .practices a:hover {
    padding-inline-start: 16px;
  }
  .practices a:hover .name {
    color: var(--accent);
  }
  .num,
  .count {
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .count {
    text-align: end;
  }
  .arrow {
    display: inline-block;
    margin-inline-start: 8px;
    transition: transform 0.4s var(--ease);
  }
  :global([dir='rtl']) .arrow {
    transform: scaleX(-1);
  }
  .practices a:hover .arrow {
    transform: translateX(6px);
    color: var(--fg);
  }
  :global([dir='rtl']) .practices a:hover .arrow {
    transform: scaleX(-1) translateX(6px);
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.4vw, 64px);
    line-height: 1;
    transition: color 0.2s;
  }
  .desc {
    color: var(--muted);
    max-width: 44ch;
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .practices a {
      grid-template-columns: 40px 1fr auto;
    }
    .desc {
      grid-column: 2 / -1;
      grid-row: 2;
    }
  }

  /* Showreel modal */
  .reel {
    width: min(92vw, 1400px);
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: visible;
  }
  .reel::backdrop {
    background: rgb(10 10 10 / 0.92);
  }
  .reel-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .reel-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .reel-close {
    display: block;
    margin: 0 0 12px auto;
    font-size: 14px;
  }
  :global([dir='rtl']) .reel-close {
    margin: 0 auto 12px 0;
  }
</style>

<script>
  // Category filter for "Selected work"
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] .card');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((card) => {
        card.hidden = f !== 'all' && card.dataset.category !== f;
        card.classList.add('is-in');
      });
    }),
  );

  // Showreel modal
  const dialog = document.querySelector<HTMLDialogElement>('[data-reel]');
  if (dialog) {
    const frame = dialog.querySelector<HTMLElement>('[data-reel-frame]')!;
    document.querySelector('[data-reel-open]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = dialog.dataset.src!;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      dialog.showModal();
    });
    const close = () => dialog.close();
    dialog.querySelector('[data-reel-close]')!.addEventListener('click', close);
    dialog.addEventListener('click', (e) => e.target === dialog && close());
    dialog.addEventListener('close', () => frame.replaceChildren());
  }
</script>
