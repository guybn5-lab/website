---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';
import {
  categories,
  categoryIntros,
  categoryLabels,
  href,
  langPaths,
  localHref,
  t,
  type Lang,
} from '../../i18n/ui';
import { byCategory, embedUrl, featured } from '../../lib/projects';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;

const work = featured();
const usedCategories = categories.filter((c) => work.some((p) => p.category === c));
const reelSrc = embedUrl(site.showreel.full);
---

<Base lang={lang} path="/" overlayHeader>
  <section class="hero">
    <div class="hero-bg" style="--h:28">
      {
        site.showreel.loop ? (
          <video
            src={href(site.showreel.loop)}
            poster={site.showreel.poster ? href(site.showreel.poster) : undefined}
            autoplay
            muted
            loop
            playsinline
            aria-hidden="true"
          />
        ) : site.showreel.poster ? (
          <img src={href(site.showreel.poster)} alt="" />
        ) : (
          <div class="ph" />
        )
      }
    </div>
    <div class="hero-content wrap">
      <p class="eyebrow hero-cats">
        {categories.map((c) => <span>{categoryLabels[c][lang]}</span>)}
      </p>
      <h1>{site.name[lang]}</h1>
      <p class="tagline">{site.tagline[lang]}</p>
      {
        reelSrc && (
          <button type="button" class="btn reel-btn" data-reel-open>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
            </svg>
            {t(lang, 'home.reel')}
          </button>
        )
      }
    </div>
    <a class="scroll-cue" href="#work" aria-label={t(lang, 'home.selected')}><span></span></a>
  </section>

  <section class="work wrap" id="work">
    <div class="section-head">
      <h2 class="eyebrow">{t(lang, 'home.selected')}</h2>
      {
        usedCategories.length > 1 && (
          <div class="filters" role="group" aria-label={t(lang, 'home.selected')}>
            <button type="button" aria-pressed="true" data-filter="all">
              {t(lang, 'home.all')}
            </button>
            {usedCategories.map((c) => (
              <button type="button" aria-pressed="false" data-filter={c}>
                {categoryLabels[c][lang]}
              </button>
            ))}
          </div>
        )
      }
    </div>
    <div class="grid" data-grid>
      {work.map((p, i) => <ProjectCard project={p} lang={lang} eager={i < 2} />)}
    </div>
  </section>

  <section class="practices wrap">
    <h2 class="eyebrow">{t(lang, 'home.practices')}</h2>
    <ol>
      {
        categories.map((c, i) => (
          <li class="reveal">
            <a href={localHref(lang, `/${c}/`)}>
              <span class="num">0{i + 1}</span>
              <span class="name">{categoryLabels[c][lang]}</span>
              <span class="desc">{categoryIntros[c][lang]}</span>
              <span class="count">
                {byCategory(c).length}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="about wrap">
    <Media src={site.portrait} alt={site.name[lang]} seed="portrait" ratio="4 / 5" class="portrait reveal" />
    <div class="about-text reveal">
      <h2 class="eyebrow">{t(lang, 'nav.about')}</h2>
      <p class="lead">{site.intro[lang]}</p>
      <a class="btn" href={localHref(lang, '/about/')}>{t(lang, 'home.aboutMore')}</a>
    </div>
  </section>

  {
    reelSrc && (
      <dialog class="reel" data-reel data-src={reelSrc} aria-label={t(lang, 'home.reel')}>
        <button type="button" class="reel-close" data-reel-close>
          {t(lang, 'nav.close')} ✕
        </button>
        <div class="reel-frame" data-reel-frame />
      </dialog>
    )
  }
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--header-h) + 40px) clamp(56px, 9vh, 110px);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
  }
  .hero-bg video,
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg) 0%, rgb(14 14 13 / 0.35) 45%, rgb(14 14 13 / 0.2) 100%);
  }
  .hero-content {
    position: relative;
  }
  .hero-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin-bottom: 20px;
  }
  .hero-cats span:not(:last-child)::after {
    content: '/';
    margin-inline: 12px;
    opacity: 0.5;
  }
  h1 {
    font-size: clamp(56px, 13vw, 210px);
    line-height: 0.92;
    letter-spacing: -0.035em;
    animation: rise 1.2s var(--ease) both;
  }
  :root[lang='he'] h1 {
    letter-spacing: -0.01em;
  }
  .tagline {
    max-width: 36ch;
    margin: clamp(20px, 3vw, 32px) 0 0;
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.4;
    color: rgb(237 235 229 / 0.85);
    animation: rise 1.2s 0.15s var(--ease) both;
  }
  .reel-btn {
    margin-top: 32px;
    background: rgb(237 235 229 / 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: rise 1.2s 0.3s var(--ease) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .scroll-cue {
    position: absolute;
    bottom: 28px;
    inset-inline-end: var(--gutter);
    width: 1px;
    height: 56px;
    background: var(--line);
    overflow: hidden;
  }
  .scroll-cue span {
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: cue 2.2s var(--ease) infinite;
  }
  @keyframes cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  /* Selected work */
  .work {
    padding-top: clamp(64px, 9vw, 120px);
    scroll-margin-top: var(--header-h);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: clamp(32px, 4vw, 56px);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filters button {
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    color: var(--muted);
    transition: all 0.25s var(--ease);
  }
  .filters button:hover {
    color: var(--fg);
    border-color: rgb(237 235 229 / 0.4);
  }
  .filters button[aria-pressed='true'] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .grid :global(.card[hidden]) {
    display: none;
  }

  /* Practices index */
  .practices {
    padding-top: clamp(96px, 12vw, 180px);
  }
  .practices ol {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .practices li {
    border-bottom: 1px solid var(--line);
  }
  .practices a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 1fr) 72px;
    gap: 24px;
    align-items: baseline;
    padding-block: clamp(24px, 3.2vw, 44px);
    transition: padding 0.5s var(--ease);
  }
  .practices a:hover {
    padding-inline-start: 16px;
  }
  .num,
  .count {
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .count {
    text-align: end;
  }
  .arrow {
    display: inline-block;
    margin-inline-start: 8px;
    transition: transform 0.4s var(--ease);
  }
  :global([dir='rtl']) .arrow {
    transform: scaleX(-1);
  }
  .practices a:hover .arrow {
    transform: translateX(6px);
    color: var(--fg);
  }
  :global([dir='rtl']) .practices a:hover .arrow {
    transform: scaleX(-1) translateX(6px);
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(30px, 4.4vw, 64px);
    line-height: 1;
  }
  .desc {
    color: var(--muted);
    max-width: 44ch;
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .practices a {
      grid-template-columns: 40px 1fr auto;
    }
    .desc {
      grid-column: 2 / -1;
      grid-row: 2;
    }
  }

  /* About teaser */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
    padding-top: clamp(96px, 12vw, 180px);
  }
  .about :global(.portrait) {
    max-width: 520px;
  }
  .lead {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 38px);
    line-height: 1.3;
    margin: 20px 0 32px;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  /* Showreel modal */
  .reel {
    width: min(92vw, 1400px);
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    overflow: visible;
  }
  .reel::backdrop {
    background: rgb(0 0 0 / 0.92);
  }
  .reel-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .reel-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .reel-close {
    display: block;
    margin: 0 0 12px auto;
    font-size: 14px;
  }
  :global([dir='rtl']) .reel-close {
    margin: 0 auto 12px 0;
  }
</style>

<script>
  // Category filter for "Selected work"
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] .card');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((card) => {
        card.hidden = f !== 'all' && card.dataset.category !== f;
        card.classList.add('is-in');
      });
    }),
  );

  // Showreel modal
  const dialog = document.querySelector<HTMLDialogElement>('[data-reel]');
  if (dialog) {
    const frame = dialog.querySelector<HTMLElement>('[data-reel-frame]')!;
    document.querySelector('[data-reel-open]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = dialog.dataset.src!;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      dialog.showModal();
    });
    const close = () => dialog.close();
    dialog.querySelector('[data-reel-close]')!.addEventListener('click', close);
    dialog.addEventListener('click', (e) => e.target === dialog && close());
    dialog.addEventListener('close', () => frame.replaceChildren());
  }
</script>
