---
import Base from '../../../layouts/Base.astro';
import Media from '../../../components/Media.astro';
import Award from '../../../components/Award.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import Embed from '../../../components/Embed.astro';
import { embedKind, isSocial } from '../../../lib/embeds';
import { categoryLabels, formatLabels, href, languages, localHref, t, type Lang } from '../../../i18n/ui';
import {
  byCategory,
  coverFor,
  localize,
  mainPlayerUrl,
  paragraphs,
  projects,
  youtubeThumb,
} from '../../../lib/projects';

export const getStaticPaths = () =>
  languages.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug } })));

const lang = Astro.params.lang as Lang;
const p = projects.find((x) => x.slug === Astro.params.slug)!;

const title = localize(p.title, lang);
const summary = localize(p.summary, lang);
const highlight = localize(p.highlight, lang);
const description = paragraphs(localize(p.description, lang));
const festivals = p.festivals?.[lang] ?? [];
const siblings = byCategory(p.category);
const next = siblings.length > 1 ? siblings[(siblings.indexOf(p) + 1) % siblings.length] : undefined;
const cover = coverFor(p);
const hasVideo = Boolean(p.video?.id);
const player = mainPlayerUrl(p);
const embeds = (p.embeds ?? []).map((e) =>
  typeof e === 'string' ? { url: e, title: '' } : { url: e.url, title: localize(e.title, lang) },
);
const episodeEmbeds = embeds.filter((e) => !isSocial(e.url));
const socialEmbeds = embeds.filter((e) => isSocial(e.url));
const hasInstagram = socialEmbeds.some((e) => embedKind(e.url).kind === 'instagram');
// Long lists start collapsed with a "Show all" button.
const PREVIEW = { episodes: 6, social: 6 };
// Episodes list: skip the one already shown as the main video.
const episodes = (p.videos ?? []).filter((v) => v.id !== p.video?.id);

const facts = [
  { label: t(lang, 'project.client'), value: localize(p.client, lang) },
  { label: t(lang, 'project.format'), value: p.format ? localize(formatLabels[p.format], lang) : '' },
  { label: t(lang, 'project.role'), value: localize(p.role, lang) },
  { label: t(lang, 'project.year'), value: p.year ? String(p.year) : '' },
  { label: t(lang, 'project.duration'), value: p.duration ?? '' },
].filter((f) => f.value);
---

<Base
  lang={lang}
  path={`/work/${p.slug}/`}
  section={`/${p.category}/`}
  title={title}
  description={summary || highlight || undefined}
  image={cover || undefined}
>
  <article class:list={['project', { 'has-video': hasVideo }]}>
    <div class="wrap layout">
      <aside class="art">
        {
          hasVideo ? (
            <VideoPlayer
              video={p.video}
              cover={p.video?.provider === 'youtube' ? youtubeThumb(p.video.id) : cover}
              title={title}
              seed={p.slug}
              lang={lang}
            />
          ) : (
            <Media src={cover} alt={title} seed={p.slug} ratio="1 / 1" eager class="cover" label={title} />
          )
        }
      </aside>

      <div class="content">
        <header>
          <a class="back eyebrow link-underline" href={localHref(lang, `/${p.category}/`)}>
            {categoryLabels[p.category][lang]}
          </a>
          <h1>{title}</h1>
          {
            (p.award || highlight) && (
              <p class="badges">
                {p.award && <Award lang={lang} />}
                {highlight && <span class="highlight">{highlight}</span>}
              </p>
            )
          }
          {summary && <p class="summary">{summary}</p>}
        </header>

        {
          player && (
            <div class="player-embed">
              <Embed url={player} title={title} />
            </div>
          )
        }

        {
          p.links && p.links.length > 0 && (
            <div class="links">
              {p.links.map((l) => (
                <a class="btn" href={l.url} target="_blank" rel="noopener">
                  {localize(l.label, lang)} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }

        {description.length > 0 && <div class="text">{description.map((para) => <p>{para}</p>)}</div>}

        {
          facts.length > 0 && (
            <dl class="facts">
              {facts.map((f) => (
                <div>
                  <dt class="eyebrow">{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
              {p.credits && p.credits.length > 0 && (
                <div>
                  <dt class="eyebrow">{t(lang, 'project.credits')}</dt>
                  <dd>
                    <ul class="credits">
                      {p.credits.map((c) => (
                        <li>
                          <span class="muted">{localize(c.role, lang)}</span> {localize(c.name, lang)}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
          )
        }

        {
          festivals.length > 0 && (
            <section class="festivals">
              <h2 class="eyebrow">{t(lang, 'project.festivals')}</h2>
              <ul>
                {festivals.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    {
      episodes.length > 0 && (
        <section class="episodes wrap">
          <div class="section-head">
            <h2 class="eyebrow">{t(lang, 'project.videos')}</h2>
          </div>
          <ul>
            {episodes.map((v) => (
              <li class="reveal">
                <VideoPlayer
                  video={{ provider: v.provider, id: v.id }}
                  cover={v.provider === 'youtube' ? youtubeThumb(v.id) : ''}
                  title={localize(v.title, lang)}
                  seed={v.id}
                  lang={lang}
                />
                <p class="ep-title">
                  {localize(v.title, lang)}
                  {v.duration && <span class="muted"> · {v.duration}</span>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      episodeEmbeds.length > 0 && (
        <section class="more wrap" data-collapsible>
          <div class="section-head">
            <h2 class="eyebrow">{t(lang, 'project.episodes')}</h2>
            <span class="eyebrow">{episodeEmbeds.length}</span>
          </div>
          <div class="episodes-grid">
            {episodeEmbeds.map((e, i) => (
              <div class="item" data-extra={i >= PREVIEW.episodes ? '' : undefined}>
                <Embed url={e.url} title={e.title || title} />
              </div>
            ))}
          </div>
          {episodeEmbeds.length > PREVIEW.episodes && (
            <button type="button" class="btn show-all" data-show-all>
              {t(lang, 'project.showAll')} ({episodeEmbeds.length})
            </button>
          )}
        </section>
      )
    }

    {
      socialEmbeds.length > 0 && (
        <section class="more wrap" data-collapsible>
          <div class="section-head">
            <h2 class="eyebrow">{t(lang, 'project.social')}</h2>
            <span class="eyebrow">{socialEmbeds.length}</span>
          </div>
          <div class="social-grid">
            {socialEmbeds.map((e, i) => (
              <div class="item" data-extra={i >= PREVIEW.social ? '' : undefined}>
                <Embed url={e.url} title={e.title || title} />
              </div>
            ))}
          </div>
          {socialEmbeds.length > PREVIEW.social && (
            <button type="button" class="btn show-all" data-show-all>
              {t(lang, 'project.showAll')} ({socialEmbeds.length})
            </button>
          )}
        </section>
      )
    }

    {hasInstagram && <script is:inline async src="https://www.instagram.com/embed.js" />}

    {
      p.stills && p.stills.length > 0 && (
        <section class="stills wrap">
          <h2 class="sr-only">{t(lang, 'project.stills')}</h2>
          {p.stills.map((s, i) => (
            <figure class="reveal">
              <img src={s.startsWith('http') ? s : href(s)} alt={`${title} — ${i + 1}`} loading="lazy" />
            </figure>
          ))}
        </section>
      )
    }

    {
      next && (
        <nav class="next wrap" aria-label={t(lang, 'project.next')}>
          <a href={localHref(lang, `/work/${next.slug}/`)}>
            <span class="eyebrow">{t(lang, 'project.next')}</span>
            <span class="next-title">
              {localize(next.title, lang)} <span class="arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    padding-top: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .art {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .art :global(.cover) {
    border-radius: var(--radius);
  }
  /* Video projects: player spans the full width above the text */
  .has-video .layout {
    grid-template-columns: 1fr;
  }
  .has-video .art {
    position: static;
  }
  .has-video .content {
    max-width: 820px;
  }

  .back {
    display: inline-block;
  }
  h1 {
    margin-top: 18px;
    font-size: clamp(44px, 6.4vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  :root[lang='he'] h1 {
    letter-spacing: -0.01em;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 22px 0 0;
  }
  .highlight {
    font-size: 15px;
    font-weight: 500;
  }
  .summary {
    max-width: 44ch;
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: clamp(21px, 1.9vw, 27px);
    line-height: 1.35;
  }
  .player-embed {
    margin-top: 32px;
  }
  .more {
    padding-top: clamp(72px, 9vw, 130px);
  }
  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 16px clamp(16px, 2vw, 28px);
    align-items: start;
  }
  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(20px, 2.5vw, 32px);
    align-items: start;
  }
  [data-collapsible]:not(.is-open) [data-extra] {
    display: none;
  }
  .show-all {
    margin-top: 28px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .text {
    margin-top: clamp(32px, 4vw, 48px);
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.75;
    max-width: 62ch;
  }
  .facts {
    margin: clamp(32px, 4vw, 48px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    border-top: 1px solid var(--line);
  }
  .facts > div {
    padding: 16px 0;
    padding-inline-end: 16px;
    border-bottom: 1px solid var(--line);
  }
  dd {
    margin: 6px 0 0;
  }
  .credits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .festivals {
    margin-top: 40px;
  }
  .festivals ul {
    margin: 12px 0 0;
    padding-inline-start: 1.1em;
  }

  .episodes {
    padding-top: clamp(72px, 9vw, 130px);
  }
  .episodes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px) clamp(16px, 2vw, 28px);
  }
  .ep-title {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.45;
  }
  .episodes :global(.disc) {
    width: 56px;
  }

  .stills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 24px);
    align-items: start;
    padding-top: clamp(72px, 9vw, 130px);
  }
  .stills figure {
    margin: 0;
  }
  .stills figure {
    display: flex;
    justify-content: center;
    background: var(--bg-raised);
    border-radius: var(--radius);
  }
  .stills img {
    width: auto;
    max-width: 100%;
    max-height: 72vh;
    height: auto;
    border-radius: var(--radius);
  }

  .next {
    margin-top: clamp(80px, 10vw, 150px);
  }
  .next a {
    display: grid;
    gap: 12px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .next-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 88px);
    line-height: 1;
    transition: color 0.2s;
  }
  .next a:hover .next-title {
    color: var(--accent);
  }
  .arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }
  :global([dir='rtl']) .arrow {
    transform: scaleX(-1);
  }
  .next a:hover .arrow {
    transform: translateX(10px);
  }
  :global([dir='rtl']) .next a:hover .arrow {
    transform: scaleX(-1) translateX(10px);
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .art {
      position: static;
      max-width: 520px;
    }
    .episodes ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .episodes ul,
    .stills {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-collapsible]').forEach((section) => {
    section.querySelector('[data-show-all]')?.addEventListener('click', (e) => {
      section.classList.add('is-open');
      (e.currentTarget as HTMLElement).remove();
      // Instagram posts that were hidden need to be processed now that they're visible.
      (window as any).instgrm?.Embeds?.process();
    });
  });
</script>
