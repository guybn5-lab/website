---
/**
 * Root URL: send visitors to /he/ or /en/ based on a remembered choice or their browser language.
 * Without JavaScript they see two links.
 */
import '../styles/global.css';
import { site } from '../data/site';
import { href } from '../i18n/ui';
const he = href('/he/');
const en = href('/en/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name.en} · {site.name.he}</title>
    <meta name="description" content={site.tagline.en} />
    <link rel="alternate" hreflang="he" href={new URL(he, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(en, Astro.site)} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <script is:inline define:vars={{ he, en }}>
      let lang;
      try { lang = localStorage.getItem('lang'); } catch {}
      if (!lang) lang = (navigator.languages || [navigator.language]).some((l) => /^(he|iw)\b/i.test(l)) ? 'he' : 'en';
      location.replace(lang === 'he' ? he : en);
    </script>
  </head>
  <body>
    <main class="choose">
      <a href={he} lang="he" dir="rtl">{site.name.he}<span>עברית</span></a>
      <a href={en} lang="en">{site.name.en}<span>English</span></a>
    </main>
    <style>
      .choose {
        min-height: 100svh;
        display: grid;
        place-content: center;
        gap: 40px;
        text-align: center;
      }
      .choose a {
        display: grid;
        gap: 6px;
        font-family: var(--font-display);
        font-size: clamp(32px, 6vw, 64px);
      }
      .choose span {
        font-family: var(--font-body);
        font-size: 14px;
        color: var(--muted);
      }
    </style>
  </body>
</html>
